	(text "GPIO labels are logical connections, NOT a physical 30-pin header drawing. Verify the actual board labels."
		(at 15 28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "efc30eea-3d04-45a4-80bc-13ccc445bf74")
	)
	(text "Panel OUT -> next panel IN. Separate fused power to every panel. Do not carry panel current through perfboard."
		(at 15 36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0a142c65-40cf-4ded-90a5-30d57b496d56")
	)
	(text "5V buffer outputs NEVER connect to ESP32 inputs. U2/U3 must be HCT parts, not HC-only replacements."
		(at 15 173 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "80365600-2462-4501-91ef-b4a5356061a9")
	)
	(text "MAX9814 powered at 3.3V; verify actual output range before connecting GPIO34 (ADC1)."
		(at 15 179 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d2aff4aa-c2ce-466f-ba71-af4b2f42249c")
	)
	(text "J4 stays open until panel pin8 is identified. Never bridge both positions or ground a driven E output."
		(at 210 185 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c15be56c-ed52-4d85-98ac-1175e3ac8fc8")
	)
	(text "Supply case and terminals require suitable protection, earth and strain relief. This sheet covers LOW-VOLTAGE DC wiring only."
		(at 15 274 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c95195af-e074-4bd3-938a-db764b49832c")
	)
